eft: 34px;\n        right: 34px;\n        bottom: 28px;\n        height: 134px;\n        border-radius: 24px;\n        background: linear-gradient(180deg, rgba(255,255,255,0.96) 0%, rgba(248,251,255,0.96) 100%);\n        border: 1px solid #dbe4f1;\n        box-shadow: 0 10px 20px rgba(36, 57, 102, 0.06);\n        padding: 18px 28px 16px 28px;\n      }\n\n      .ribbon-top {\n        display: flex;\n        align-items: center;\n        gap: 26px;\n      }\n\n      .ribbon-label {\n        min-width: 138px;\n        font-size: 17px;\n        line-height: 1;\n        font-weight: 700;\n        letter-spacing: -0.03em;\n        color: #334258;\n      }\n\n      .alloc {\n        display: flex;\n        align-items: center;\n        gap: 12px;\n      }\n\n      .bar {\n        width: 290px;\n        height: 12px;\n        border-radius: 999px;\n        background: #dfe7f3;\n        position: relative;\n        overflow: hidden;\n      }\n\n      .fill {\n        position: absolute;\n        left: 0;\n        top: 0;\n        bottom: 0;\n        border-radius: 999px;\n        background: linear-gradient(90deg, #7696cb 0%, #5f87bc 100%);\n      }\n\n      .alloc span {\n        font-size: 15px;\n        line-height: 1;\n        font-weight: 600;\n        color: #576a86;\n        white-space: nowrap;\n      }\n\n      .ribbon-note {\n        position: absolute;\n        left: 0;\n        right: 0;\n        bottom: 18px;\n        text-align: center;\n        font-size: 18px;\n        line-height: 1.2;\n        font-weight: 700;\n        letter-spacing: -0.03em;\n        color: #3a4a62;\n      }\n\n      .footer-line {\n        position: absolute;\n        left: 112px;\n        top: 992px;\n        width: 1536px;\n        height: 1px;\n        background: rgba(0, 0, 0, 0.9);\n      }\n\n      .footer-logo {\n        position: absolute;\n        left: 1692px;\n        top: 962px;\n        width: 114px;\n        height: 59px;\n        object-fit: contain;\n      }\n    </style>\n  </head>\n  <body>\n    <section class=\"slide\" aria-label=\"Designer investor deck slide 12\">\n      <p class=\"eyebrow\">The Ask</p>\n      <h1 class=\"header\">Raising $1.25M to launch pilots, prove value, and establish repeatable deployment</h1>\n      <p class=\"subheader\">Post-money SAFE • ~18–20 months of runway</p>\n\n      <div class=\"master\" aria-label=\"Financing ask and milestones\">\n        <div class=\"left-col\">\n          <div class=\"ask-pill\">The Ask</div>\n          <div class=\"amount\">$1.25M</div>\n          <div class=\"safe\">Pre-Seed SAFE</div>\n          <div class=\"left-copy\">\n            A finite proof-stage round sized to convert product readiness into repeatable deployment evidence.\n          </div>\n\n          <div class=\"divider\"></div>\n\n          <div class=\"terms\">\n            <div class=\"term-chip\">Post-money SAFE</div>\n            <div class=\"term-chip\">Milestone-based use</div>\n          </div>\n\n          <div class=\"proof-box\">\n            <p>\n              Capital is tied to a defined proof plan: build only what is needed for launch, deploy in real clinical settings,\n              and validate enough value to support repeatable expansion and seed readiness.\n            </p>\n          </div>\n\n          <div class=\"mini-grid\">\n            <div class=\"mini-cell\">\n              <div class=\"mini-num\">Build</div>\n              <div class=\"mini-copy\">Core hires to support implementation, product hardening, and deployment readiness</div>\n            </div>\n            <div class=\"mini-cell\">\n              <div class=\"mini-num\">Deploy</div>\n              <div class=\"mini-copy\">Pilot sites to establish live operational proof in real visit environments</div>\n            </div>\n            <div class=\"mini-cell\">\n              <div class=\"mini-num\">Validate</div>\n              <div class=\"mini-copy\">Runway to execute, measure, and package outcomes into a seed-ready proof story</div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"right-col\">\n          <h2 class=\"right-title\">What this round unlocks</h2>\n\n          <div class=\"top-stats\">\n            <div class=\"stat\">\n              <div class=\"n\">2</div>\n              <div class=\"l\">key hires</div>\n            </div>\n            <div class=\"stat\">\n              <div class=\"n\">3</div>\n              <div class=\"l\">pilot sites</div>\n            </div>\n            <div class=\"stat\">\n              <div class=\"n\">18–20</div>\n              <div class=\"l\">months runway</div>\n            </div>\n          </div>\n\n          <div class=\"milestone\">\n            <div class=\"m-head\">\n              <div class=\"m-tag\">Build</div>\n              <div class=\"m-title\">Pilot-ready deployment foundation</div>\n            </div>\n            <div class=\"m-body\">\n              <div class=\"m-left\">\n                <strong>Founding engineer in place</strong>; clinician-grade product loop live with the minimum workflow and reporting layer required to go live reliably.\n              </div>\n              <div class=\"m-right\">\n                Complete the operational backbone needed for implementation, onboarding, and site-specific deployment readiness.\n              </div>\n            </div>\n            <div class=\"chip-row\">\n              <div class=\"micro\">implementation + customer success hire</div>\n              <div class=\"micro\">pilot onboarding workflows</div>\n              <div class=\"micro\">site-specific deployment readiness</div>\n              <div class=\"micro\">reporting and operational instrumentation</div>\n            </div>\n          </div>\n\n          <div class=\"milestone\">\n            <div class=\"m-head\">\n              <div class=\"m-tag\">Deploy</div>\n              <div class=\"m-title\">Launch 3 pilot sites</div>\n            </div>\n            <div class=\"m-body\">\n              <div class=\"m-left\">\n                <strong>Implementation / ops lead in place</strong>; pilot sites launched with a repeatable rollout motion that can be reused beyond the first installs.\n              </div>\n              <div class=\"m-right\">\n                Demonstrate that Designer can be implemented and used in real visit environments without bespoke deployment every time.\n              </div>\n            </div>\n            <div class=\"chip-row\">\n              <div class=\"micro\">live pilot implementations</div>\n              <div class=\"micro\">provider and staff onboarding</div>\n              <div class=\"micro\">site feedback loop into product</div>\n            </div>\n          </div>\n\n          <div class=\"milestone\" style=\"margin-bottom:0;\">\n            <div class=\"m-head\">\n              <div class=\"m-tag\">Validate</div>\n              <div class=\"m-title\">Prove value and repeatability</div>\n            </div>\n            <div class=\"m-body\">\n              <div class=\"m-left\">\n                <strong>Measurable pilot outcomes</strong>; enough evidence to show the product story holds in live deployment and can convert into a seed-ready proof package.\n              </div>\n              <div class=\"m-right\">\n                Generate the evidence needed to move from first pilots to a repeatable deployment motion investors can underwrite.\n              </div>\n            </div>\n            <div class=\"chip-row\">\n              <div class=\"micro\">usage and workflow adoption signals</div>\n              <div class=\"micro\">time / operational value metrics</div>\n              <div class=\"micro\">referenceable pilot outcomes</div>\n              <div class=\"micro\">clear next-round proof points</div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"sequence\" aria-hidden=\"true\">\n          <div class=\"node\">Build</div>\n          <div class=\"arrow\"></div>\n          <div class=\"node\">Deploy</div>\n          <div class=\"arrow\"></div>\n          <div class=\"node\">Validate</div>\n          <div class=\"arrow\"></div>\n          <div class=\"node\">Seed-ready proof</div>\n        </div>\n\n        <div class=\"bottom-ribbon\">\n          <div class=\"ribbon-top\">\n            <div class=\"ribbon-label\">Use of funds</div>\n\n            <div class=\"alloc\">\n              <div class=\"bar\"><div class=\"fill\" style=\"width: 46%;\"></div></div>\n              <span>Team</span>\n            </div>\n\n            <div class=\"alloc\">\n              <div class=\"bar\" style=\"width: 200px;\"><div class=\"fill\" style=\"width: 24%;\"></div></div>\n              <span>Pilot deployment</span>\n            </div>\n\n            <div class=\"alloc\">\n              <div class=\"bar\" style=\"width: 230px;\"><div class=\"fill\" style=\"width: 12%;\"></div></div>\n              <span>Product &amp; data infrastructure</span>\n            </div>\n\n            <div class=\"alloc\">\n              <div class=\"bar\" style=\"width: 160px;\"><div class=\"fill\" style=\"width: 10%;\"></div></div>\n              <span>Validation / operating buffer</span>\n            </div>\n          </div>\n\n          <div class=\"ribbon-note\">This round funds a concrete proof plan — not scale before proof.</div>\n        </div>\n      </div>\n\n      <div class=\"footer-line\" aria-hidden=\"true\"></div>\n      <img\n        class=\"footer-logo\"\n        src=\"../../../../assets/logo/designer-health-logo-black.svg\"\n        alt=\"\"\n        aria-hidden=\"true\"\n      />\n    </section>\n  </body>\n</html>"
