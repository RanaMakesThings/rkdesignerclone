ackground: #a5caf4; }\n  .queue .plus {\n    width: auto;\n    height: 26px;\n    border-radius: 20px;\n    padding: 0 9px;\n    background: #edf5ff;\n    color: #56759e;\n    border: 1px solid #d7e4f5;\n    font-size: 12px;\n    font-weight: 700;\n    line-height: 24px;\n  }\n\n  .caption-box {\n    position: absolute;\n    left: 596px;\n    top: 510px;\n    width: 724px;\n    height: 144px;\n    border-radius: 24px;\n    background: linear-gradient(180deg, rgba(244,248,253,0.97) 0%, rgba(250,252,255,0.97) 100%);\n    border: 1.5px solid #dce6f2;\n    box-shadow: 0 10px 24px rgba(20, 33, 58, 0.05);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    padding: 0 30px;\n  }\n  .caption-box .big {\n    font-size: 26px;\n    line-height: 1.15;\n    font-weight: 800;\n    letter-spacing: -0.7px;\n    color: #18233f;\n  }\n  .caption-box .sub {\n    margin-top: 8px;\n    font-size: 15px;\n    line-height: 1.35;\n    color: #62718b;\n    font-weight: 500;\n  }\n\n  .micro {\n    position: absolute;\n    font-size: 15px;\n    line-height: 1.25;\n    color: #7a889d;\n    font-weight: 600;\n  }\n  .callout {\n    position: absolute;\n    padding: 10px 14px;\n    border-radius: 14px;\n    background: #fff7f7;\n    border: 1.5px solid #f0d0d0;\n    color: #8a4c55;\n    font-size: 15px;\n    font-weight: 700;\n    line-height: 1.2;\n    box-shadow: 0 8px 18px rgba(120, 64, 74, 0.06);\n  }\n  .callout.blue {\n    background: #f5f9ff;\n    border-color: #d4e2f3;\n    color: #577192;\n  }\n\n</style>\n</head>\n<body>\n<div class=\"slide\">\n  <div class=\"top-rule\" aria-hidden=\"true\"></div>\n  <div class=\"title\">Mentorship is too important to leave to chance.</div>\n  <div class=\"subtitle\">People often find mentors through luck, visibility, or whoever has time, not through a process designed for fit.</div>\n\n  <div class=\"figure-wrap\">\n    <div class=\"panel-label label-left\">People looking for help</div>\n    <div class=\"panel-label label-mid\">How mentor search happens today</div>\n    <div class=\"panel-label label-right\">What access actually looks like</div>\n\n    <div class=\"card\" style=\"left:16px; top:72px;\">\n      <div class=\"icon\">A</div>\n      <div class=\"name\">Alex</div>\n      <div class=\"role\">New manager<br/>needs leadership advice</div>\n      <div class=\"pill\">Looking for fit</div>\n    </div>\n\n    <div class=\"card\" style=\"left:16px; top:252px;\">\n      <div class=\"icon\">J</div>\n      <div class=\"name\">Jordan</div>\n      <div class=\"role\">Career switcher<br/>needs domain guidance</div>\n      <div class=\"pill\">Unsure where to start</div>\n    </div>\n\n    <div class=\"card\" style=\"left:16px; top:432px;\">\n      <div class=\"icon\">S</div>\n      <div class=\"name\">Sam</div>\n      <div class=\"role\">High-potential IC<br/>wants growth coaching</div>\n      <div class=\"pill\">Needs timely access</div>\n    </div>\n\n    <div class=\"node\" style=\"left:392px; top:86px;\">Slack posts</div>\n    <div class=\"node small muted\" style=\"left:610px; top:38px;\">No reply</div>\n    <div class=\"node\" style=\"left:592px; top:144px;\">Ask a manager</div>\n    <div class=\"node small muted\" style=\"left:812px; top:118px;\">Limited network</div>\n\n    <div class=\"node\" style=\"left:364px; top:268px;\">Warm intros</div>\n    <div class=\"node danger small\" style=\"left:560px; top:278px;\">Not the right fit</div>\n    <div class=\"node\" style=\"left:744px; top:246px;\">Who’s visible?</div>\n    <div class=\"node small muted\" style=\"left:944px; top:294px;\">Timing mismatch</div>\n\n    <div class=\"node\" style=\"left:396px; top:460px;\">Event follow-up</div>\n    <div class=\"node danger small\" style=\"left:600px; top:476px;\">Cold outreach</div>\n    <div class=\"node\" style=\"left:796px; top:444px;\">Who has time?</div>\n    <div class=\"node small muted\" style=\"left:986px; top:440px;\">Falls through</div>\n\n    <div class=\"callout\" style=\"left:1144px; top:40px;\">Most paths depend on luck,<br/>visibility, or spare time.</div>\n\n    <div class=\"mentor\" style=\"left:1286px; top:84px; opacity:.7;\">\n      <div class=\"avatar\">M</div>\n      <div class=\"title1\">Mentor A</div>\n      <div class=\"title2\">Deep experience, low visibility</div>\n      <div class=\"tag\">Hard to discover</div>\n    </div>\n\n    <div class=\"mentor hot\" style=\"left:1360px; top:224px;\">\n      <div class=\"avatar\">K</div>\n      <div class=\"title1\">Visible mentor</div>\n      <div class=\"title2\">Known by everyone, already overloaded</div>\n      <div class=\"tag\">Gets most inbound requests</div>\n      <div class=\"queue\">\n        <span></span><span></span><span></span><span></span><span></span>\n        <div class=\"plus\">+12</div>\n      </div>\n    </div>\n\n    <div class=\"mentor\" style=\"left:1286px; top:424px; opacity:.72;\">\n      <div class=\"avatar\">R</div>\n      <div class=\"title1\">Mentor B</div>\n      <div class=\"title2\">Great match for some needs</div>\n      <div class=\"tag\">Often missed</div>\n    </div>\n\n    <div class=\"mentor\" style=\"left:1562px; top:424px; opacity:.72;\">\n      <div class=\"avatar\">L</div>\n      <div class=\"title1\">Mentor C</div>\n      <div class=\"title2\">Available in pockets</div>\n      <div class=\"tag\">Not surfaced consistently</div>\n    </div>\n\n    <div class=\"callout blue\" style=\"left:1452px; top:600px;\">Qualified mentors exist,<br/>but access is fragmented.</div>\n\n    <div class=\"caption-box\">\n      <div>\n        <div class=\"big\">The current matching experience is uneven, manual, and easy to miss.</div>\n        <div class=\"sub\">High-need people navigate fragmented search paths while the most visible mentors absorb the demand.</div>\n      </div>\n    </div>\n\n    <div class=\"micro\" style=\"left:330px; top:598px;\">Search is manual</div>\n    <div class=\"micro\" style=\"left:898px; top:598px;\">Outc