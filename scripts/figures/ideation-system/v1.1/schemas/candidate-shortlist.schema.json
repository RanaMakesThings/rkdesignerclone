{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designer.health/schemas/candidate-shortlist.schema.json",
  "title": "Candidate Shortlist",
  "type": "object",
  "required": [
    "scored_candidates",
    "shortlist"
  ],
  "properties": {
    "scored_candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "auto_rejects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "shortlist": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "diversity_sufficient": {
      "type": "boolean"
    },
    "selection_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}