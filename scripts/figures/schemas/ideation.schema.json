{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "figures/ideation.schema.json",
  "title": "Figure Ideation Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "slug",
    "provider",
    "model",
    "briefPath",
    "summary",
    "ideas",
    "shortlist",
    "selectionAdvice"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "enum": ["claude", "openai"]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "briefPath": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "ideas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "composition",
          "placement",
          "assetMode",
          "imageIntent",
          "styleIntent",
          "imageQueries",
          "whyItWorks",
          "mainRisk"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "composition": {
            "type": "string",
            "minLength": 1
          },
          "placement": {
            "type": "string",
            "minLength": 1
          },
          "assetMode": {
            "type": "string",
            "enum": ["native", "photo", "hybrid"]
          },
          "imageIntent": {
            "type": "string"
          },
          "styleIntent": {
            "type": "string"
          },
          "imageQueries": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "imageBoard": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": [
              "dir",
              "manifestPath",
              "assetBoardHtmlPath",
              "assetBoardPngPath",
              "verdict",
              "bestCandidateNote",
              "error"
            ],
            "properties": {
              "dir": {
                "type": "string"
              },
              "manifestPath": {
                "type": "string"
              },
              "assetBoardHtmlPath": {
                "type": "string"
              },
              "assetBoardPngPath": {
                "type": "string"
              },
              "verdict": {
                "type": "string"
              },
              "bestCandidateNote": {
                "type": "string"
              },
              "error": {
                "type": "string"
              }
            }
          },
          "whyItWorks": {
            "type": "string",
            "minLength": 1
          },
          "mainRisk": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "shortlist": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selectionAdvice": {
      "type": "string"
    }
  }
}
